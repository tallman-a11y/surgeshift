# Supabase — the app's database and auth. Without these the marketing site still
# renders; everything behind the login fails closed.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic — the conversation and the copywriting tool.
ANTHROPIC_API_KEY=

# Voyage — embeddings for the Shift memory spine. Optional: without it the
# conversation works, it just stops recalling across sessions.
VOYAGE_API_KEY=

# ── Shift family ──────────────────────────────────────────────────────────────
# The shared project carrying the cross-product bus (shift_cross_product_events +
# shift_identities from migration 003). Every Shift product points at the SAME one.
#
# Unset, the bus falls back to this product's own database: publish and consume still
# work, but LendShift and SurgeShift cannot see the handoffs. /api/shift/family
# reports which mode is live.
SHIFT_FAMILY_SUPABASE_URL=
SHIFT_FAMILY_SUPABASE_SERVICE_KEY=

# Path to the shared parking-lot helper. Defaults to
# ~/.claude/shift-parking-lot/shiftlog.mjs; the bridge no-ops when it is absent.
SHIFT_PARKING_LOT=

# Cross-product referral pipe, shared with RealShift and LendShift. The SAME secret
# in every product's environment; requests are HMAC-signed over the raw body.
PARTNER_SECRET=
# Who inbound referrals land with when the sender does not name an agent.
PARTNER_REFERRAL_OWNER_EMAIL=
# Override the sibling endpoints (defaults are the production URLs).
REALSHIFT_REFERRAL_URL=
LENDSHIFT_REFERRAL_URL=
